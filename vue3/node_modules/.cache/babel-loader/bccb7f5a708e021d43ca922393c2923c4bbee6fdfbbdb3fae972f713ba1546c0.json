iv>\r\n      </SwiperSlide>\r\n\r\n      <!-- کارت نهایی -->\r\n      <SwiperSlide>\r\n        <div class=\"intro-card\">\r\n          <img src=\"/assets/images/thankyou.png\" alt=\"Thanks\" class=\"intro-img\" />\r\n          <h2>آماده‌ای شروع کنی؟ 🚀</h2>\r\n          <p>به صفحه‌ی ورود برو و حسابت رو بساز یا وارد شو.</p>\r\n          <RouterLink :to=\"{ path: '/login' }\" class=\"login-btn\">\r\n            ورود\r\n          </RouterLink>\r\n        </div>\r\n      </SwiperSlide>\r\n    </Swiper>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { useRouter } from 'vue-router'\r\nimport { Swiper, SwiperSlide } from 'swiper/vue'\r\nimport 'swiper/css'\r\nimport 'swiper/css/pagination'\r\nimport { Pagination } from 'swiper/modules'\r\n\r\nconst router = useRouter()\r\n\r\n</script>\r\n\r\n<style scoped>\r\n.intro-container {\r\n  width: 100%;\r\n  height: 100vh;\r\n  background: linear-gradient(to bottom, #f8fafc, #e9ecef);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n.intro-swiper {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n.intro-card {\r\n  height: 100%;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  align-items: center;\r\n  padding: 30px;\r\n  text-align: center;\r\n}\r\n.intro-img {\r\n  width: 200px;\r\n  height: auto;\r\n  margin-bottom: 20px;\r\n}\r\nh2 {\r\n  font-size: 1.8rem;\r\n  margin-bottom: 10px;\r\n  color: #212529;\r\n}\r\np {\r\n  max-width: 500px;\r\n  color: #495057;\r\n  font-size: 1rem;\r\n}\r\n.login-btn {\r\n  background-color: #0d6efd;\r\n  color: white;\r\n  text-decoration: none;\r\n  padding: 12px 30px;\r\n  border-radius: 10px;\r\n  margin-top: 20px;\r\n  font-weight: bold;\r\n  transition: 0.3s;\r\n}\r\n.login-btn:hover {\r\n  background-color: #0b5ed7;\r\n}\r\n</style>\r\n","<template>\r\n  <div class=\"intro-container\">\r\n    <Swiper\r\n      :modules=\"[Pagination]\"\r\n      direction=\"vertical\"\r\n      :mousewheel=\"true\"\r\n      :pagination=\"{ clickable: true }\"\r\n      class=\"intro-swiper\"\r\n    >\r\n      <!-- کارت معرفی خودت -->\r\n      <SwiperSlide>\r\n        <div class=\"intro-card\">\r\n          <img src=\"/assets/images/me.png\" alt=\"Me\" class=\"intro-img\" />\r\n          <h2>سلام! من دانیال فرد 👋</h2>\r\n          <p>\r\n            برنامه نویس تحت وب و فعال اجتماعی با هدف ساخت سامانه‌هایی که کار رو برای مردم ساده‌تر کنه \r\n            در خدمت شمام\r\n            ❤️\r\n            <hr>\r\n            اگر بخوایین میتونید با من به روش های پایین در ارتباط باشید و حتی کار هامو دنبال کنید\r\n        <ol>\r\n            <li><a href=\"tel:+989336160295\">شماره تماس</a></li>\r\n            <li><a href=\"mailto:29danialfrd69@gmail.com\">gmail</a></li>\r\n            <li><a href=\"https://github.com/daniyelford\">github</a></li>\r\n            <li><a href=\"https://www.npmjs.com/~danialfrd\">npm</a></li>\r\n        </ol>  \r\n        </p>\r\n\r\n        </div>\r\n      </SwiperSlide>\r\n\r\n      <!-- کارت پشتیبانی -->\r\n      <SwiperSlide>\r\n        <div class=\"intro-card\">\r\n          <img src=\"/assets/images/support.png\" alt=\"Support\" class=\"intro-img\" />\r\n          <h2>پشتیبانی و ارتباط</h2>\r\n          <p>\r\n            هر موقع سوال، مشکل یا پیشنهادی داشتی، از طریق بخش پشتیبانی با ما در تماس باش.\r\n            ما همیشه پاسخ‌گو هستیم.\r\n          </p>\r\n        </div>\r\n      </SwiperSlide>\r\n\r\n      <!-- کارت نهایی -->\r\n      <SwiperSlide>\r\n        <div class=\"intro-card\">\r\n          <img src=\"/assets/images/thankyou.png\" alt=\"Thanks\" class=\"intro-img\" />\r\n          <h2>آماده‌ای شروع کنی؟ 🚀</h2>\r\n          <p>به صفحه‌ی ورود برو و حسابت رو بساز یا وارد شو.</p>\r\n          <RouterLink :to=\"{ path: '/login' }\" class=\"login-btn\">\r\n            ورود\r\n          </RouterLink>\r\n        </div>\r\n      </SwiperSlide>\r\n    </Swiper>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { useRouter } from 'vue-router'\r\nimport { Swiper, SwiperSlide } from 'swiper/vue'\r\nimport 'swiper/css'\r\nimport 'swiper/css/pagination'\r\nimport { Pagination } from 'swiper/modules'\r\n\r\nconst router = useRouter()\r\n\r\n</script>\r\n\r\n<style scoped>\r\n.intro-container {\r\n  width: 100%;\r\n  height: 100vh;\r\n  background: linear-gradient(to bottom, #f8fafc, #e9ecef);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n.intro-swiper {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n.intro-card {\r\n  height: 100%;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  align-items: center;\r\n  padding: 30px;\r\n  text-align: center;\r\n}\r\n.intro-img {\r\n  width: 200px;\r\n  height: auto;\r\n  margin-bottom: 20px;\r\n}\r\nh2 {\r\n  font-size: 1.8rem;\r\n  margin-bottom: 10px;\r\n  color: #212529;\r\n}\r\np {\r\n  max-width: 500px;\r\n  color: #495057;\r\n  font-size: 1rem;\r\n}\r\n.login-btn {\r\n  background-color: #0d6efd;\r\n  color: white;\r\n  text-decoration: none;\r\n  padding: 12px 30px;\r\n  border-radius: 10px;\r\n  margin-top: 20px;\r\n  font-weight: bold;\r\n  transition: 0.3s;\r\n}\r\n.login-btn:hover {\r\n  background-color: #0b5ed7;\r\n}\r\n</style>\r\n"],"mappings":";;;;;;;AA2DA,SAASA,SAAS,QAAQ,YAAY;AACtC,SAASC,MAAM,EAAEC,WAAW,QAAQ,YAAY;AAChD,OAAO,YAAY;AACnB,OAAO,uBAAuB;AAC9B,SAASC,UAAU,QAAQ,gBAAgB;;;;IAE3C,MAAMC,MAAM,GAAGJ,SAAS,CAAC,CAAC;;;2BChExBK,mBAAA,CAsDM,OAtDNC,UAsDM,GArDJC,YAAA,CAoDSC,MAAA,CAAAP,MAAA;QAnDNQ,OAAO,GAAGD,MAAA,CAAAL,UAAA,CAAU;QACrBO,SAAS,EAAC,UAAU;QACnBC,UAAU,EAAE,IAAI;QAChBC,UAAU,EAAE;UAAAC,SAAA;QAAA,CAAmB;QAChCC,KAAK,EAAC;;0BAGN,MAmBc,CAnBdP,YAAA,CAmBcC,MAAA,CAAAN,WAAA;4BAlBZ,MAiBM,KAAAa,MAAA,QAAAA,MAAA,OAjBNC,mBAAA,CAiBM;YAjBDF,KAAK,EAAC;UAAY,IACrBE,mBAAA,CAA8D;YAAzDC,GAAG,EAAC,uBAAuB;YAACC,GAAG,EAAC,IAAI;YAACJ,KAAK,EAAC;cAChDE,mBAAA,CAA+B,YAA3B,wBAAsB,GAC1BA,mBAAA,CAYE,Y,iBAZC,6GAID,GAAAA,mBAAA,CAAI,O,iBAAA,wFAER,GAAAA,mBAAA,CAKK,aAJDA,mBAAA,CAAmD,aAA/CA,mBAAA,CAA0C;YAAvCG,IAAI,EAAC;UAAmB,GAAC,YAAU,E,GA