{"ast":null,"code":"import { createElementVNode as _createElementVNode, createStaticVNode as _createStaticVNode, openBlock as _openBlock, createElementBlock as _createElementBlock } from \"vue\";\nconst _hoisted_1 = {\n  class: \"bodyA\"\n};\nexport function render(_ctx, _cache) {\n  return _openBlock(), _createElementBlock(\"div\", _hoisted_1, [...(_cache[0] || (_cache[0] = [_createStaticVNode(\"<div class=\\\"container\\\"><div class=\\\"radar-system\\\"><div class=\\\"radar-base\\\"></div><div class=\\\"radar-grid\\\"><div class=\\\"radar-ring\\\"></div><div class=\\\"radar-ring\\\"></div><div class=\\\"radar-ring\\\"></div><div class=\\\"radar-ring\\\"></div><div class=\\\"radar-crosshair\\\"></div><div class=\\\"radar-sweep\\\"></div><div class=\\\"radar-blips\\\"><div class=\\\"blip\\\"></div><div class=\\\"blip\\\"></div><div class=\\\"blip\\\"></div><div class=\\\"blip\\\"></div></div><div class=\\\"scan-lines\\\"><div class=\\\"scan-line\\\"></div><div class=\\\"scan-line\\\"></div><div class=\\\"scan-line\\\"></div><div class=\\\"scan-line\\\"></div></div></div></div><div class=\\\"status-indicators\\\"><div class=\\\"indicator\\\"></div><div class=\\\"indicator\\\"></div><div class=\\\"indicator\\\"></div><div class=\\\"indicator\\\"></div></div><div class=\\\"loading-info\\\"><div class=\\\"loading-text\\\">Scanning System</div><div class=\\\"progress-bar\\\"><div class=\\\"progress-fill\\\"></div></div></div></div>\", 1)]))]);\n}","map":{"version":3,"names":["class","_createElementBlock","_hoisted_1","_cache"],"sources":["D:\\GitHub\\chat\\vue3\\src\\components\\tooles\\RadarAnimation.vue"],"sourcesContent":["<template>\r\n    <div class=\"bodyA\">\r\n        <div class=\"container\">\r\n            <div class=\"radar-system\">\r\n                <div class=\"radar-base\"></div>\r\n                \r\n                <div class=\"radar-grid\">\r\n                    <div class=\"radar-ring\"></div>\r\n                    <div class=\"radar-ring\"></div>\r\n                    <div class=\"radar-ring\"></div>\r\n                    <div class=\"radar-ring\"></div>\r\n                    \r\n                    <div class=\"radar-crosshair\"></div>\r\n                    \r\n                    <div class=\"radar-sweep\"></div>\r\n                    \r\n                    <div class=\"radar-blips\">\r\n                        <div class=\"blip\"></div>\r\n                        <div class=\"blip\"></div>\r\n                        <div class=\"blip\"></div>\r\n                        <div class=\"blip\"></div>\r\n                    </div>\r\n                    \r\n                    <div class=\"scan-lines\">\r\n                        <div class=\"scan-line\"></div>\r\n                        <div class=\"scan-line\"></div>\r\n                        <div class=\"scan-line\"></div>\r\n                        <div class=\"scan-line\"></div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            \r\n            <div class=\"status-indicators\">\r\n                <div class=\"indicator\"></div>\r\n                <div class=\"indicator\"></div>\r\n                <div class=\"indicator\"></div>\r\n                <div class=\"indicator\"></div>\r\n            </div>\r\n            \r\n            <div class=\"loading-info\">\r\n                <div class=\"loading-text\">Scanning System</div>\r\n                <div class=\"progress-bar\">\r\n                    <div class=\"progress-fill\"></div>\r\n                </div>\r\n                <!-- <div class=\"percentage\" id=\"percentage\">0%</div> -->\r\n            </div>\r\n        </div>\r\n    </div>\r\n    <script>\r\n        // Simulate loading percentage\r\n        let percentage = 0;\r\n        const percentageElement = document.getElementById('percentage');\r\n        \r\n        const updatePercentage = () => {\r\n            percentage = (percentage + Math.random() * 3) % 100;\r\n            percentageElement.textContent = Math.floor(percentage) + '%';\r\n            \r\n            // Add some randomness to make it more realistic\r\n            if (Math.random() > 0.7) {\r\n                percentageElement.style.color = '#ffff00';\r\n                setTimeout(() => {\r\n                    percentageElement.style.color = '#00ff00';\r\n                }, 200);\r\n            }\r\n        };\r\n        \r\n        setInterval(updatePercentage, 100);\r\n        \r\n        // Add dynamic blips\r\n        const radarBlips = document.querySelector('.radar-blips');\r\n        \r\n        const createDynamicBlip = () => {\r\n            const blip = document.createElement('div');\r\n            blip.className = 'blip';\r\n            blip.style.top = Math.random() * 80 + 10 + '%';\r\n            blip.style.left = Math.random() * 80 + 10 + '%';\r\n            blip.style.animationDelay = '0s';\r\n            radarBlips.appendChild(blip);\r\n            \r\n            setTimeout(() => {\r\n                blip.remove();\r\n            }, 2000);\r\n        };\r\n        \r\n        setInterval(createDynamicBlip, 1500);\r\n        \r\n        // Add sound effect simulation (visual feedback)\r\n        document.addEventListener('click', () => {\r\n            const container = document.querySelector('.container');\r\n            container.style.animation = 'none';\r\n            setTimeout(() => {\r\n                container.style.animation = '';\r\n            }, 10);\r\n        });\r\n    </script>\r\n    <style scoped>\r\n    .bodyA {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    height: 100vh;\r\n    background: radial-gradient(circle, #000 60%, #0a0a0a);\r\n    color: #00ff00;\r\n    overflow: hidden;\r\n    font-family: 'Consolas', monospace;\r\n    }\r\n\r\n    .container {\r\n    position: relative;\r\n    width: 400px;\r\n    height: 400px;\r\n    animation: pulse 2s infinite alternate;\r\n    }\r\n\r\n    @keyframes pulse {\r\n    0% {\r\n        transform: scale(1);\r\n    }\r\n    100% {\r\n        transform: scale(1.02);\r\n    }\r\n    }\r\n\r\n    .radar-system {\r\n    position: relative;\r\n    width: 100%;\r\n    height: 100%;\r\n    }\r\n\r\n    .radar-base {\r\n    position: absolute;\r\n    width: 100%;\r\n    height: 100%;\r\n    border-radius: 50%;\r\n    background: radial-gradient(circle, rgba(0, 255, 0, 0.1) 30%, transparent 70%);\r\n    box-shadow: 0 0 30px rgba(0, 255, 0, 0.3);\r\n    }\r\n\r\n    .radar-grid {\r\n    position: absolute;\r\n    width: 100%;\r\n    height: 100%;\r\n    border-radius: 50%;\r\n    overflow: hidden;\r\n    }\r\n\r\n    .radar-ring {\r\n    position: absolute;\r\n    border: 1px solid rgba(0, 255, 0, 0.2);\r\n    border-radius: 50%;\r\n    width: 25%;\r\n    height: 25%;\r\n    top: 37.5%;\r\n    left: 37.5%;\r\n    }\r\n    .radar-ring:nth-child(2) {\r\n    width: 50%;\r\n    height: 50%;\r\n    top: 25%;\r\n    left: 25%;\r\n    }\r\n    .radar-ring:nth-child(3) {\r\n    width: 75%;\r\n    height: 75%;\r\n    top: 12.5%;\r\n    left: 12.5%;\r\n    }\r\n    .radar-ring:nth-child(4) {\r\n    width: 100%;\r\n    height: 100%;\r\n    top: 0;\r\n    left: 0;\r\n    }\r\n\r\n    .radar-crosshair {\r\n    position: absolute;\r\n    width: 100%;\r\n    height: 100%;\r\n    background: repeating-linear-gradient(\r\n        to right,\r\n        rgba(0, 255, 0, 0.2) 0,\r\n        rgba(0, 255, 0, 0.2) 1px,\r\n        transparent 1px,\r\n        transparent 50%\r\n        ),\r\n        repeating-linear-gradient(\r\n        to bottom,\r\n        rgba(0, 255, 0, 0.2) 0,\r\n        rgba(0, 255, 0, 0.2) 1px,\r\n        transparent 1px,\r\n        transparent 50%\r\n        );\r\n    }\r\n\r\n    .radar-sweep {\r\n    position: absolute;\r\n    width: 50%;\r\n    height: 100%;\r\n    background: linear-gradient(90deg, rgba(0, 255, 0, 0.3) 0%, transparent 100%);\r\n    transform-origin: right center;\r\n    animation: sweep 2s linear infinite;\r\n    border-radius: 50%;\r\n    }\r\n\r\n    @keyframes sweep {\r\n    0% {\r\n        transform: rotate(0deg);\r\n    }\r\n    100% {\r\n        transform: rotate(360deg);\r\n    }\r\n    }\r\n\r\n    .blip {\r\n    position: absolute;\r\n    width: 6px;\r\n    height: 6px;\r\n    background: #00ff00;\r\n    border-radius: 50%;\r\n    box-shadow: 0 0 8px #00ff00;\r\n    animation: blip 2s linear;\r\n    }\r\n\r\n    @keyframes blip {\r\n    0% {\r\n        opacity: 0;\r\n    }\r\n    20% {\r\n        opacity: 1;\r\n    }\r\n    100% {\r\n        opacity: 0;\r\n    }\r\n    }\r\n\r\n    .status-indicators {\r\n    display: flex;\r\n    justify-content: center;\r\n    margin-top: 20px;\r\n    }\r\n\r\n    .indicator {\r\n    width: 10px;\r\n    height: 10px;\r\n    background: #00ff00;\r\n    margin: 0 5px;\r\n    border-radius: 50%;\r\n    animation: blink 1.5s infinite alternate;\r\n    }\r\n\r\n    @keyframes blink {\r\n    from {\r\n        opacity: 0.3;\r\n    }\r\n    to {\r\n        opacity: 1;\r\n    }\r\n    }\r\n\r\n    .loading-info {\r\n    text-align: center;\r\n    margin-top: 20px;\r\n    }\r\n\r\n    .loading-text {\r\n    margin-bottom: 10px;\r\n    font-size: 18px;\r\n    color: #00ff00;\r\n    }\r\n\r\n    .progress-bar {\r\n    width: 80%;\r\n    height: 6px;\r\n    background: rgba(0, 255, 0, 0.2);\r\n    margin: 0 auto;\r\n    border-radius: 3px;\r\n    overflow: hidden;\r\n    }\r\n\r\n    .progress-fill {\r\n    height: 100%;\r\n    background: #00ff00;\r\n    transition: width 0.3s linear;\r\n    }\r\n\r\n    .percentage {\r\n    margin-top: 5px;\r\n    font-size: 14px;\r\n    color: #00ff00;\r\n    }\r\n    </style>\r\n</template>"],"mappings":";;EACSA,KAAK,EAAC;AAAO;;uBAAlBC,mBAAA,CA8CM,OA9CNC,UA8CM,OAAAC,MAAA,QAAAA,MAAA,O","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}