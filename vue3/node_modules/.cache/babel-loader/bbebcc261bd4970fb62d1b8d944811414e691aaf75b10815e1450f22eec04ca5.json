{"ast":null,"code":"import { createElementVNode as _createElementVNode, createStaticVNode as _createStaticVNode, openBlock as _openBlock, createElementBlock as _createElementBlock } from \"vue\";\nconst _hoisted_1 = {\n  class: \"bodyA\"\n};\nexport function render(_ctx, _cache) {\n  return _openBlock(), _createElementBlock(\"div\", _hoisted_1, [...(_cache[0] || (_cache[0] = [_createStaticVNode(\"<div class=\\\"container\\\"><div class=\\\"radar-system\\\"><div class=\\\"radar-base\\\"></div><div class=\\\"radar-grid\\\"><div class=\\\"radar-ring\\\"></div><div class=\\\"radar-ring\\\"></div><div class=\\\"radar-ring\\\"></div><div class=\\\"radar-ring\\\"></div><div class=\\\"radar-crosshair\\\"></div><div class=\\\"radar-sweep\\\"></div><div class=\\\"radar-blips\\\"><div class=\\\"blip\\\"></div><div class=\\\"blip\\\"></div><div class=\\\"blip\\\"></div><div class=\\\"blip\\\"></div></div><div class=\\\"scan-lines\\\"><div class=\\\"scan-line\\\"></div><div class=\\\"scan-line\\\"></div><div class=\\\"scan-line\\\"></div><div class=\\\"scan-line\\\"></div></div></div></div><div class=\\\"status-indicators\\\"><div class=\\\"indicator\\\"></div><div class=\\\"indicator\\\"></div><div class=\\\"indicator\\\"></div><div class=\\\"indicator\\\"></div></div><div class=\\\"loading-info\\\"><div class=\\\"loading-text\\\">Scanning System</div><div class=\\\"progress-bar\\\"><div class=\\\"progress-fill\\\"></div></div></div></div>\", 1)]))]);\n}","map":{"version":3,"names":["class","_createElementBlock","_hoisted_1","_cache"],"sources":["D:\\GitHub\\chat\\vue3\\src\\components\\tooles\\RadarAnimation.vue"],"sourcesContent":["<template>\r\n    <div class=\"bodyA\">\r\n        <div class=\"container\">\r\n            <div class=\"radar-system\">\r\n                <div class=\"radar-base\"></div>\r\n                \r\n                <div class=\"radar-grid\">\r\n                    <div class=\"radar-ring\"></div>\r\n                    <div class=\"radar-ring\"></div>\r\n                    <div class=\"radar-ring\"></div>\r\n                    <div class=\"radar-ring\"></div>\r\n                    \r\n                    <div class=\"radar-crosshair\"></div>\r\n                    \r\n                    <div class=\"radar-sweep\"></div>\r\n                    \r\n                    <div class=\"radar-blips\">\r\n                        <div class=\"blip\"></div>\r\n                        <div class=\"blip\"></div>\r\n                        <div class=\"blip\"></div>\r\n                        <div class=\"blip\"></div>\r\n                    </div>\r\n                    \r\n                    <div class=\"scan-lines\">\r\n                        <div class=\"scan-line\"></div>\r\n                        <div class=\"scan-line\"></div>\r\n                        <div class=\"scan-line\"></div>\r\n                        <div class=\"scan-line\"></div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            \r\n            <div class=\"status-indicators\">\r\n                <div class=\"indicator\"></div>\r\n                <div class=\"indicator\"></div>\r\n                <div class=\"indicator\"></div>\r\n                <div class=\"indicator\"></div>\r\n            </div>\r\n            \r\n            <div class=\"loading-info\">\r\n                <div class=\"loading-text\">Scanning System</div>\r\n                <div class=\"progress-bar\">\r\n                    <div class=\"progress-fill\"></div>\r\n                </div>\r\n                <!-- <div class=\"percentage\" id=\"percentage\">0%</div> -->\r\n            </div>\r\n        </div>\r\n    </div>\r\n    <script>\r\n        // Simulate loading percentage\r\n        let percentage = 0;\r\n        const percentageElement = document.getElementById('percentage');\r\n        \r\n        const updatePercentage = () => {\r\n            percentage = (percentage + Math.random() * 3) % 100;\r\n            percentageElement.textContent = Math.floor(percentage) + '%';\r\n            \r\n            // Add some randomness to make it more realistic\r\n            if (Math.random() > 0.7) {\r\n                percentageElement.style.color = '#ffff00';\r\n                setTimeout(() => {\r\n                    percentageElement.style.color = '#00ff00';\r\n                }, 200);\r\n            }\r\n        };\r\n        \r\n        setInterval(updatePercentage, 100);\r\n        \r\n        // Add dynamic blips\r\n        const radarBlips = document.querySelector('.radar-blips');\r\n        \r\n        const createDynamicBlip = () => {\r\n            const blip = document.createElement('div');\r\n            blip.className = 'blip';\r\n            blip.style.top = Math.random() * 80 + 10 + '%';\r\n            blip.style.left = Math.random() * 80 + 10 + '%';\r\n            blip.style.animationDelay = '0s';\r\n            radarBlips.appendChild(blip);\r\n            \r\n            setTimeout(() => {\r\n                blip.remove();\r\n            }, 2000);\r\n        };\r\n        \r\n        setInterval(createDynamicBlip, 1500);\r\n        \r\n        // Add sound effect simulation (visual feedback)\r\n        document.addEventListener('click', () => {\r\n            const container = document.querySelector('.container');\r\n            container.style.animation = 'none';\r\n            setTimeout(() => {\r\n                container.style.animation = '';\r\n            }, 10);\r\n        });\r\n    </script>\r\n    <style scoped>\r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        .bodyA {\r\n            font-family: 'Arial', sans-serif;\r\n            background: #000;\r\n            color: #00ff00;\r\n            overflow: hidden;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            min-height: 100vh;\r\n            position: relative;\r\n        }\r\n\r\n        /* Background grid effect */\r\n        .bodyA::before {\r\n            content: '';\r\n            position: absolute;\r\n            top: 0;\r\n            left: 0;\r\n            width: 100%;\r\n            height: 100%;\r\n            background-image: \r\n                linear-gradient(rgba(0, 255, 0, 0.1) 1px, transparent 1px),\r\n                linear-gradient(90deg, rgba(0, 255, 0, 0.1) 1px, transparent 1px);\r\n            background-size: 50px 50px;\r\n            animation: grid-move 10s linear infinite;\r\n        }\r\n\r\n        @keyframes grid-move {\r\n            0% { transform: translate(0, 0); }\r\n            100% { transform: translate(50px, 50px); }\r\n        }\r\n\r\n        .container {\r\n            position: relative;\r\n            width: 400px;\r\n            height: 400px;\r\n            perspective: 1000px;\r\n            z-index: 1;\r\n        }\r\n\r\n        .radar-system {\r\n            width: 100%;\r\n            height: 100%;\r\n            position: relative;\r\n            transform-style: preserve-3d;\r\n            animation: radar-tilt 6s ease-in-out infinite;\r\n        }\r\n\r\n        @keyframes radar-tilt {\r\n            0%, 100% { transform: rotateX(20deg) rotateY(0deg); }\r\n            50% { transform: rotateX(20deg) rotateY(180deg); }\r\n        }\r\n\r\n        .radar-base {\r\n            position: absolute;\r\n            width: 100%;\r\n            height: 100%;\r\n            border-radius: 50%;\r\n            background: radial-gradient(circle at center, \r\n                rgba(0, 255, 0, 0.1) 0%, \r\n                rgba(0, 255, 0, 0.05) 30%, \r\n                rgba(0, 0, 0, 0.8) 70%);\r\n            border: 2px solid rgba(0, 255, 0, 0.3);\r\n            box-shadow: \r\n                0 0 50px rgba(0, 255, 0, 0.5),\r\n                inset 0 0 50px rgba(0, 255, 0, 0.2);\r\n        }\r\n\r\n        .radar-grid {\r\n            position: absolute;\r\n            width: 100%;\r\n            height: 100%;\r\n            border-radius: 50%;\r\n            overflow: hidden;\r\n        }\r\n\r\n        .radar-ring {\r\n            position: absolute;\r\n            border: 1px solid rgba(0, 255, 0, 0.3);\r\n            border-radius: 50%;\r\n            top: 50%;\r\n            left: 50%;\r\n            transform: translate(-50%, -50%);\r\n        }\r\n\r\n        .radar-ring:nth-child(1) { width: 25%; height: 25%; }\r\n        .radar-ring:nth-child(2) { width: 50%; height: 50%; }\r\n        .radar-ring:nth-child(3) { width: 75%; height: 75%; }\r\n        .radar-ring:nth-child(4) { width: 100%; height: 100%; }\r\n\r\n        .radar-crosshair {\r\n            position: absolute;\r\n            width: 100%;\r\n            height: 100%;\r\n            top: 0;\r\n            left: 0;\r\n        }\r\n\r\n        .radar-crosshair::before,\r\n        .radar-crosshair::after {\r\n            content: '';\r\n            position: absolute;\r\n            background: rgba(0, 255, 0, 0.2);\r\n        }\r\n\r\n        .radar-crosshair::before {\r\n            width: 1px;\r\n            height: 100%;\r\n            left: 50%;\r\n            transform: translateX(-50%);\r\n        }\r\n\r\n        .radar-crosshair::after {\r\n            width: 100%;\r\n            height: 1px;\r\n            top: 50%;\r\n            transform: translateY(-50%);\r\n        }\r\n\r\n        .radar-sweep {\r\n            position: absolute;\r\n            width: 50%;\r\n            height: 50%;\r\n            top: 50%;\r\n            left: 50%;\r\n            transform-origin: 0% 0%;\r\n            animation: sweep 3s linear infinite;\r\n        }\r\n\r\n        .radar-sweep::before {\r\n            content: '';\r\n            position: absolute;\r\n            width: 100%;\r\n            height: 100%;\r\n            background: linear-gradient(90deg, \r\n                transparent 0%, \r\n                rgba(0, 255, 0, 0.8) 50%, \r\n                transparent 100%);\r\n            filter: blur(2px);\r\n        }\r\n\r\n        .radar-sweep::after {\r\n            content: '';\r\n            position: absolute;\r\n            width: 0;\r\n            height: 0;\r\n            border-style: solid;\r\n            border-width: 0 0 10px 10px;\r\n            border-color: transparent transparent #00ff00 transparent;\r\n            top: -10px;\r\n            left: 0;\r\n            filter: drop-shadow(0 0 5px #00ff00);\r\n        }\r\n\r\n        @keyframes sweep {\r\n            0% { transform: rotate(0deg); }\r\n            100% { transform: rotate(360deg); }\r\n        }\r\n\r\n        .radar-blips {\r\n            position: absolute;\r\n            width: 100%;\r\n            height: 100%;\r\n            top: 0;\r\n            left: 0;\r\n        }\r\n\r\n        .blip {\r\n            position: absolute;\r\n            width: 8px;\r\n            height: 8px;\r\n            background: #00ff00;\r\n            border-radius: 50%;\r\n            box-shadow: 0 0 10px #00ff00;\r\n            animation: blip-pulse 2s ease-in-out infinite;\r\n        }\r\n\r\n        .blip:nth-child(1) {\r\n            top: 30%;\r\n            left: 60%;\r\n            animation-delay: 0s;\r\n        }\r\n\r\n        .blip:nth-child(2) {\r\n            top: 70%;\r\n            left: 40%;\r\n            animation-delay: 0.5s;\r\n        }\r\n\r\n        .blip:nth-child(3) {\r\n            top: 50%;\r\n            left: 80%;\r\n            animation-delay: 1s;\r\n        }\r\n\r\n        .blip:nth-child(4) {\r\n            top: 20%;\r\n            left: 30%;\r\n            animation-delay: 1.5s;\r\n        }\r\n\r\n        @keyframes blip-pulse {\r\n            0%, 100% { \r\n                transform: scale(1);\r\n                opacity: 1;\r\n            }\r\n            50% { \r\n                transform: scale(1.5);\r\n                opacity: 0.5;\r\n            }\r\n        }\r\n\r\n        .loading-info {\r\n            position: absolute;\r\n            bottom: -80px;\r\n            left: 50%;\r\n            transform: translateX(-50%);\r\n            text-align: center;\r\n            width: 100%;\r\n        }\r\n\r\n        .loading-text {\r\n            font-size: 14px;\r\n            color: #00ff00;\r\n            margin-bottom: 10px;\r\n            text-transform: uppercase;\r\n            letter-spacing: 2px;\r\n            animation: text-flicker 2s ease-in-out infinite;\r\n        }\r\n\r\n        @keyframes text-flicker {\r\n            0%, 100% { opacity: 1; }\r\n            50% { opacity: 0.7; }\r\n        }\r\n\r\n        .progress-bar {\r\n            width: 200px;\r\n            height: 4px;\r\n            background: rgba(0, 255, 0, 0.2);\r\n            border-radius: 2px;\r\n            overflow: hidden;\r\n            margin: 0 auto;\r\n        }\r\n\r\n        .progress-fill {\r\n            height: 100%;\r\n            background: linear-gradient(90deg, #00ff00, #00aa00);\r\n            width: 0%;\r\n            animation: progress-load 5s ease-in-out infinite;\r\n            box-shadow: 0 0 10px #00ff00;\r\n        }\r\n\r\n        @keyframes progress-load {\r\n            0% { width: 0%; }\r\n            50% { width: 75%; }\r\n            100% { width: 100%; }\r\n        }\r\n\r\n        .percentage {\r\n            font-size: 12px;\r\n            color: #00ff00;\r\n            margin-top: 5px;\r\n            font-family: 'Courier New', monospace;\r\n        }\r\n\r\n        .status-indicators {\r\n            position: absolute;\r\n            top: -60px;\r\n            left: 50%;\r\n            transform: translateX(-50%);\r\n            display: flex;\r\n            gap: 10px;\r\n        }\r\n\r\n        .indicator {\r\n            width: 8px;\r\n            height: 8px;\r\n            background: #00ff00;\r\n            border-radius: 50%;\r\n            animation: indicator-blink 1s ease-in-out infinite;\r\n        }\r\n\r\n        .indicator:nth-child(2) { animation-delay: 0.2s; }\r\n        .indicator:nth-child(3) { animation-delay: 0.4s; }\r\n        .indicator:nth-child(4) { animation-delay: 0.6s; }\r\n\r\n        @keyframes indicator-blink {\r\n            0%, 100% { opacity: 0.3; }\r\n            50% { opacity: 1; }\r\n        }\r\n\r\n        .scan-lines {\r\n            position: absolute;\r\n            width: 100%;\r\n            height: 100%;\r\n            top: 0;\r\n            left: 0;\r\n            overflow: hidden;\r\n            pointer-events: none;\r\n        }\r\n\r\n        .scan-line {\r\n            position: absolute;\r\n            width: 100%;\r\n            height: 2px;\r\n            background: linear-gradient(90deg, \r\n                transparent, \r\n                rgba(0, 255, 0, 0.3), \r\n                transparent);\r\n            animation: scan-line-move 4s linear infinite;\r\n        }\r\n\r\n        .scan-line:nth-child(2) { animation-delay: 1s; }\r\n        .scan-line:nth-child(3) { animation-delay: 2s; }\r\n        .scan-line:nth-child(4) { animation-delay: 3s; }\r\n\r\n        @keyframes scan-line-move {\r\n            0% { transform: translateY(-100%); }\r\n            100% { transform: translateY(100%); }\r\n        }\r\n\r\n        @media (max-width: 480px) {\r\n            .container {\r\n                width: 300px;\r\n                height: 300px;\r\n            }\r\n            \r\n            .loading-info {\r\n                bottom: -60px;\r\n            }\r\n            \r\n            .progress-bar {\r\n                width: 150px;\r\n            }\r\n        }\r\n    </style>\r\n</template>"],"mappings":";;EACSA,KAAK,EAAC;AAAO;;uBAAlBC,mBAAA,CA8CM,OA9CNC,UA8CM,OAAAC,MAAA,QAAAA,MAAA,O","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}