   class=\"fixed inset-0 bg-black bg-opacity-50 flex justify-center items-center z-50\"\r\n    >\r\n      <div class=\"bg-white rounded-2xl p-6 w-11/12 max-w-lg relative\">\r\n        <button\r\n          @click=\"closeModal\"\r\n          class=\"absolute top-2 right-2 text-gray-500 hover:text-black\"\r\n        >\r\n          ✕\r\n        </button>\r\n        <h2 class=\"text-2xl font-bold mb-4\">{{ activeCard.title }}</h2>\r\n        <p class=\"text-gray-700\">{{ activeCard.long }}</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref } from \"vue\"\r\nimport { Swiper, SwiperSlide } from \"swiper/vue\"\r\nimport { Navigation, Autoplay } from \"swiper/modules\"\r\nimport \"swiper/css\"\r\nimport \"swiper/css/navigation\"\r\n\r\nconst cards = [\r\n  {\r\n    title: \"ورود و ثبت‌نام\",\r\n    short: \"سریع و امن با شماره موبایل وارد شو یا ثبت‌نام کن.\",\r\n    long: \"ورود با شماره موبایل و تایید کد — بدون دردسر، امن و آماده‌ی استفاده. حساب کاربری بساز یا سریع وارد شو و از خدمات استفاده کن.\",\r\n    image: \"/images/login.png\",\r\n  },\r\n  {\r\n    title: \"چت پشتیبانی\",\r\n    short: \"دربارهٔ مشکلاتت مستقیم با پشتیبانی گفتگو کن.\",\r\n    long: \"مشکلات و سوالاتت رو به‌صورت چت ارسال کن؛ پشتیبانی پاسخ می‌ده، راهنمایی می‌شه و در صورت نیاز پیگیری رسمی انجام می‌شود.\",\r\n    image: \"/images/chat.png\",\r\n  },\r\n  {\r\n    title: \"درخواست ملاقات\",\r\n    short: \"وقت ملاقات ثبت کن و روند پیگیری را دنبال کن.\",\r\n    long: \"درخواست قرار با انتخاب تاریخ و زمان — ثبت می‌شود، برای طرف مقابل ارسال می‌شود و وضعیت پیگیری را می‌توانی مشاهده کنی.\",\r\n    image: \"/images/meeting.png\",\r\n  },\r\n  {\r\n    title: \"ضبط صدا و تبدیل به متن\",\r\n    short: \"پیام صوتی ضبط کن؛ سیستم آن را به متن تبدیل می‌کند.\",\r\n    long: \"کافیست صحبت کنی؛ صدای شما ضبط و به متن تبدیل می‌شود تا ارسال یا آرشیو شود — مناسب برای گزارش سریع و ثبت درخواست‌ها.\",\r\n    image: \"/images/voice.png\",\r\n  },\r\n  {\r\n    title: \"ارسال عکس و مدارک\",\r\n    short: \"عکس یا سند آپلود کن تا پیگیری بهتر شود.\",\r\n    long: \"تصاویر مربوط به مشکل، مدرک یا محل را بارگذاری کن — همراه با درخواستت ارسال و برای بررسی ذخیره خواهد شد.\",\r\n    image: \"/images/upload.png\",\r\n  },\r\n  {\r\n    title: \"ثبت موقعیت (Location)\",\r\n    short: \"محل موردنظر را به‌صورت دستی وارد یا روی نقشه ثبت کن.\",\r\n    long: \"اگر مکان دقیق را می‌دانی، آن را دستی وارد کن یا از نقشه انتخاب کن؛ اطلاعات موقعیت همراه درخواست ارسال و برای پیگیری استفاده می‌شود.\",\r\n    image: \"/images/location.png\",\r\n  },\r\n  {\r\n    title: \"ارجاع به نهاد مربوطه\",\r\n    short: \"درخواستت به استان یا سازمان مناسب ارسال می‌شود.\",\r\n    long: \"پس از ثبت، می‌توانی درخواست را به استان یا سازمان مرتبط ارسال کنی تا پیگیری رسمی انجام شود و وضعیت پاسخ را مشاهده کنی.\",\r\n    image: \"/images/org.png\",\r\n  },\r\n  {\r\n    title: \"مکان‌های اطراف\",\r\n    short: \"نزدیک‌ترین مکان‌ها را بر اساس دسته‌بندی و شهر ببین.\",\r\n    long: \"مکان‌ها را بر اساس دسته‌بندی (خدمات، فروش، ادارات و...) و انتخاب شهر یا موقعیت خود فیلتر کن و نزدیک‌ترین‌ها را مشاهده و تماس بگیر یا مراجعه کن.\",\r\n    image: \"/images/map.png\",\r\n  },\r\n]\r\n\r\nconst showModal = ref(false)\r\nconst activeCard = ref({})\r\n\r\nfunction openModal(card) {\r\n  activeCard.value = card\r\n  showModal.value = true\r\n}\r\n\r\nfunction closeModal() {\r\n  showModal.value = false\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.slider-container {\r\n  max-width: 900px;\r\n  margin: 40px auto;\r\n}\r\n\r\n.slider-box {\r\n  border-radius: 20px;\r\n  overflow: hidden;\r\n  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);\r\n  background: #fff;\r\n}\r\n\r\n.card {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  text-align: center;\r\n  padding: 40px 20px;\r\n  min-height: 400px;\r\n}\r\n\r\n.card-img {\r\n  width: 120px;\r\n  height: 120px;\r\n  object-fit: contain;\r\n  margin-bottom: 25px;\r\n}\r\n\r\n.card-title {\r\n  font-size: 22px;\r\n  font-weight: bold;\r\n  color: #222;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.card-text {\r\n  font-size: 15px;\r\n  color: #666;\r\n  line-height: 1.6;\r\n  max-width: 600px;\r\n}\r\n\r\n.login-btn-box {\r\n  margin-top: 30px;\r\n}\r\n\r\n.login-btn {\r\n  background: linear-gradient(90deg, #2563eb, #4f46e5);\r\n  border: none;\r\n  color: #fff;\r\n  font-size: 16px;\r\n  font-weight: bold;\r\n  padding: 12px 28px;\r\n  border-radius: 10px;\r\n  cursor: pointer;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.login-btn:hover {\r\n  transform: scale(1.05);\r\n  background: linear-gradient(90deg, #1d4ed8, #4338ca);\r\n}\r\n</style>\r\n","<template>\r\n  <div class=\"slider-container\">\r\n    <!-- Slider -->\r\n    <Swiper\r\n      :modules=\"[Navigation,Autoplay]\"\r\n      navigation\r\n      :autoplay=\"{ delay: 3000 }\"\r\n      class=\"slider-box\"\r\n    >\r\n      <SwiperSlide v-for=\"(card, index) in cards\" :key=\"index\">\r\n        <div class=\"card\">\r\n          <img  :src=\"card.image\" alt=\"\" class=\"card-img\" />\r\n          <h2 class=\"card-title\">{{ card.title }}</h2>\r\n          <p class=\"card-text\">{{ card.short }}</p>\r\n          <button\r\n            @click=\"openModal(card)\"\r\n            class=\"mt-4 px-4 py-2 bg-blue-600 text-white rounded-lg shadow hover:bg-blue-700\"\r\n          >\r\n            بیشتر بدانید\r\n          </button>\r\n          <div v-if=\"index === cards.length - 1\" class=\"login-btn-box\">\r\n            <RouterLink :to=\"{Path:'/login'}\" class=\"login-btn\">\r\n              ورود / ثبت‌نام\r\n            </RouterLink>\r\n          </div>\r\n        </div>\r\n      </SwiperSlide>\r\n    </Swiper>\r\n    <div\r\n      v-if=\"showModal\"\r\n      class=\"fixed inset-0 bg-black bg-opacity-50 flex justify-center items-center z-50\"\r\n    >\r\n      <div class=\"bg-white rounded-2xl p-6 w-11/12 max-w-lg relative\">\r\n        <button\r\n          @click=\"closeModal\"\r\n          class=\"absolute to